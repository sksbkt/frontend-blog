datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String

  // Bilingual Fields
  taglineEn       String
  taglineFa       String
  descriptionEn   String   @db.Text
  descriptionFa   String   @db.Text

  // Metadata, URLs & Layout
  coverImageUrl   String?
  lowResCoverUrl  String?     // Tiny WebP thumbnail (24-32px blurred)
  assetSource     String?     // "USER_UPLOAD" | "GITHUB_OG" | "GITHUB_ACTION_CAPTURE"
  ogCachedAt      DateTime?   // Timestamp for 14-day TTL tracking
  githubUrl       String?
  repoUrl         String?
  liveUrl         String?
  order           Int      @default(0)
  isPublished     Boolean  @default(false)
  featured        Boolean  @default(false)

  // Technical Stack & GitHub Breakdown
  technologies    String[]
  // GitHub languages: [{ name: "TypeScript", percentage: 72.4, color: "#3178c6", bytes: 142000 }]
  languages       Json?    @default("[]")

  // SCA Deep Scan Dossier (complete repo topology, manifests, commit friction, summaries)
  aiContextDigest Json?

  // Interactive Project Audit Score & Breakdown
  auditScore      Int?
  auditBreakdown  Json?
  auditedAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model TechDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique // Canonical slug: "react", "nextjs", "tailwind-css"
  name        String   // Canonical display name: "React", "Next.js", "Tailwind CSS"
  aliases     String[] @default([]) // ["reactjs", "react.js", "react-js"]
  icon        String?  // SimpleIcons slug, Lucide icon name, or custom SVG path
  summaryEn   String   @db.Text
  summaryFa   String   @db.Text
  category    String?  // "frontend", "backend", "devops", "database", etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

// Persistent ETag & Gemini caching (eliminates serverless memory loss)
model ApiCache {
  key       String   @id
  etag      String?
  data      Json
  updatedAt DateTime @updatedAt
}

// 14-day TTL CDN Asset Cache & Dual-Tier Media Registry
model AssetCache {
  id          String   @id @default(cuid())
  projectSlug String
  assetType   String   // "GITHUB_OG" | "SCREENSHOT" | "GIF"
  highResUrl  String
  lowResUrl   String?
  cachedAt    DateTime @default(now())
  expiresAt   DateTime // cachedAt + 14 days

  // Optional legacy fields for backward compatibility
  key         String?  @unique
  storageUrl  String?
  contentType String?  @default("image/png")
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  @@unique([projectSlug, assetType])
  @@index([projectSlug])
  @@index([expiresAt])
}

